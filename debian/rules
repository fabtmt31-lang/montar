#!/usr/bin/make -f

export PYBUILD_NAME=montar
PKG := debian/montar

%:
	dh $@ --with python3

override_dh_auto_build:

# Les tests demandent Qt, MLT et ffmpeg : ils tournent dans l'intégration continue.
override_dh_auto_test:

override_dh_auto_install:
	install -d $(PKG)/usr/share/montar
	cp -r src/montar $(PKG)/usr/share/montar/
	find $(PKG)/usr/share/montar -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 0755 data/montar $(PKG)/usr/bin/montar
	install -D -m 0644 data/montar.desktop $(PKG)/usr/share/applications/montar.desktop
	install -D -m 0644 data/montar.metainfo.xml $(PKG)/usr/share/metainfo/montar.metainfo.xml
	install -D -m 0644 data/montar-mime.xml $(PKG)/usr/share/mime/packages/montar.xml
	install -D -m 0644 src/montar/assets/montar.svg \
		$(PKG)/usr/share/icons/hicolor/scalable/apps/montar.svg

override_dh_python3:
	dh_python3 /usr/share/montar
