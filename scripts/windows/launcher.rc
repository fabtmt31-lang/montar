// SPDX-License-Identifier: GPL-3.0-or-later
// Icône et informations de version du lanceur (version.h : écrit par bundle.sh)
#include <winver.h>
#include "version.h"

1 ICON "montar.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_COMMAS
PRODUCTVERSION VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "appsdoc.fr"
      VALUE "FileDescription", "montar - montage video simple et local"
      VALUE "FileVersion", VERSION_DOTS
      VALUE "InternalName", "montar"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "montar.exe"
      VALUE "ProductName", "montar"
      VALUE "ProductVersion", VERSION_DOTS
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
